{
  "name": "@opencode-ai/desktop-electron",
  "private": true,
  "version": "1.14.25",
  "type": "module",
  "license": "MIT",
  "homepage": "https://opencode.ai",
  "author": {
    "name": "OpenCode",
    "email": "hello@opencode.ai"
  },
  "scripts": {
    "typecheck": "tsgo -b",
    "predev": "bun ./scripts/predev.ts",
    "dev": "bun ./scripts/dev.ts",
    "dev:renderer-only": "electron-vite dev",
    "prebuild": "bun ./scripts/prebuild.ts",
    "build": "electron-vite build",
    "build:fast": "bun ./scripts/prebuild.ts && OPENCODE_FAST_BUILD=true electron-vite build",
    "build:preview": "bun ./scripts/prebuild.ts && OPENCODE_FAST_BUILD=true OPENCODE_EXTERNAL_SERVER=true electron-vite build",
    "build:renderer": "OPENCODE_FAST_BUILD=true vite build --config electron.renderer.vite.config.ts --logLevel error",
    "build:renderer:watch": "OPENCODE_FAST_BUILD=true vite build --config electron.renderer.vite.config.ts --logLevel error --watch",
    "preview": "electron-vite preview",
    "preview:fast": "bun run build:preview && OPENCODE_FAST_BUILD=true OPENCODE_EXTERNAL_SERVER=true electron-vite preview",
    "preview:reuse": "OPENCODE_FAST_BUILD=true OPENCODE_EXTERNAL_SERVER=true electron-vite preview",
    "package": "electron-builder --config electron-builder.config.ts",
    "package:mac": "electron-builder --mac --config electron-builder.config.ts",
    "package:win": "electron-builder --win --config electron-builder.config.ts",
    "package:win:fast": "bun run build:fast && OPENCODE_FAST_BUILD=true electron-builder --win --config electron-builder.config.ts",
    "package:win:dir": "bun ./scripts/package-win-dir.ts",
    "package:win:dir:reuse": "bun ./scripts/package-win-dir.ts --reuse",
    "package:linux": "electron-builder --linux --config electron-builder.config.ts",
    "native:build": "bun install --cwd native"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "effect": "catalog:",
    "electron-context-menu": "4.1.2",
    "electron-log": "^5",
    "electron-store": "^10",
    "electron-updater": "^6",
    "electron-window-state": "^5.0.3",
    "drizzle-orm": "catalog:",
    "marked": "^15"
  },
  "devDependencies": {
    "@actions/artifact": "4.0.0",
    "@lydell/node-pty": "catalog:",
    "@opencode-ai/app": "workspace:*",
    "@opencode-ai/ui": "workspace:*",
    "@solid-primitives/i18n": "2.2.1",
    "@solid-primitives/storage": "catalog:",
    "@solidjs/meta": "catalog:",
    "@solidjs/router": "0.15.4",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@valibot/to-json-schema": "1.6.0",
    "electron": "41.2.1",
    "electron-builder": "^26",
    "electron-vite": "^5",
    "solid-js": "catalog:",
    "sury": "11.0.0-alpha.4",
    "typescript": "~5.6.2",
    "vite": "catalog:",
    "zod-openapi": "5.4.6"
  },
  "optionalDependencies": {
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.10",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.10",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.10"
  }
}
