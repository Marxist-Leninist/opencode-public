{
  "$schema": "https://opencode.ai/config.json",
  "model": "zai/glm-5.2",
  "small_model": "zai/glm-5.2",
  "provider": {
    "zai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Z.ai GLM Coding",
      "env": ["ZAI_API_KEY"],
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4",
        "timeout": 300000,
        "chunkTimeout": 60000,
      },
      "models": {
        "glm-5.2": {
          "name": "GLM-5.2",
          "family": "glm",
          "attachment": false,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
          "status": "active",
        },
      },
    },
  },
  "permission": {
    "edit": {
      "packages/opencode/migration/*": "deny",
    },
  },
  "mcp": {
    "sg3-local": {
      "type": "remote",
      "url": "http://sg3.127.0.0.1.sslip.io:3343/mcp/sse",
      "enabled": true,
    },
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
